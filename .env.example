# Copy this file to .env and fill in all values before running the app.
# Never commit .env to version control.

# Django
THE_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Google reCAPTCHA v2
RECAPTCHA_PUBLIC_KEY=your-recaptcha-site-key
RECAPTCHA_PRIVATE_KEY=your-recaptcha-secret-key

# Email (Gmail SMTP)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Database password for Docker Compose PostgreSQL container
DB_PASSWORD=choose-a-strong-password-here

# DATABASE_URL is auto-set by docker-compose — do not set manually when using Docker
